# Copy to .env.local and fill in. These are read by the Vite dev/preview server only;
# the key is never bundled into the browser code.

# OpenRouter API key (https://openrouter.ai/keys) — Jev is served via OpenRouter's /v1/systemone.
JEV_API_KEY=

# Optional overrides
# JEV_BASE_URL=https://openrouter.ai/api
# JEV_MODEL=jev-latest
