{
  "extends": "@tsconfig/node18/tsconfig.json",
  "include": ["./**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] }
  }
}
